          <material><ambient>0.40 0.26 0.52 1</ambient><diffuse>0.55 0.36 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Colored wall panels (RTAB features) -->
    <model name="wall_panel_n_red">
