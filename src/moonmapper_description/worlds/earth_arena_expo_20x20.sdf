<?xml version="1.0" ?>
<!--
  MoonMapper expo demo arena (Gazebo Sim 8).

  - Outer pad: 50 x 50 m (visual + collision ground).
  - Walled exploration arena: 20 x 20 m (x,y in [-10, 10]).
  - SW regolith / sand test patch: ~10 x 10 m (x,y in [-10, 0]).
  - Start zone open near (-7.5, -7.5); use world_preset:=expo_20x20.

  All props are static primitives for long, stable autonom runs.
-->
<sdf version="1.11">
  <world name="earth_arena_expo_20x20">

    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.50 0.48 0.46 1</ambient>
      <background>0.62 0.78 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky/>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>1.0 0.96 0.90 1</diffuse>
      <specular>0.45 0.45 0.45 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>

    <!-- 50 x 50 m outer exhibition pad -->
    <model name="expo_ground_50x50">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 50</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.1</mu><mu2>1.1</mu2></ode>
            </friction>
            <contact>
              <ode><kp>1000000.0</kp><kd>100.0</kd><min_depth>0.001</min_depth></ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 50</size></plane>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.44 1</ambient>
            <diffuse>0.58 0.58 0.60 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ~10 x 10 m regolith / sand patch (SW quadrant) -->
    <model name="expo_regolith_patch_10x10">
      <static>true</static>
      <pose>-5.0 -5.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 10.0 0.02</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.15</mu><mu2>1.15</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 10.0 0.02</size></box></geometry>
          <material>
            <ambient>0.62 0.58 0.48 1</ambient>
            <diffuse>0.78 0.72 0.58 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inner arena floor tint (visual only) -->
    <model name="arena_floor_tint_20x20">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20.0 20.0 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.52 0.46 1</ambient>
            <diffuse>0.70 0.66 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena walls (20 x 20 m, h ~0.85 m, t 0.2 m) -->
    <model name="arena_wall_north">
      <static>true</static>
      <pose>0 10.1 0.425 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 0.85</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 0.85</size></box></geometry>
          <material><ambient>0.55 0.22 0.18 1</ambient><diffuse>0.82 0.32 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="arena_wall_south">
      <static>true</static>
      <pose>0 -10.1 0.425 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 0.85</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 0.85</size></box></geometry>
          <material><ambient>0.18 0.32 0.58 1</ambient><diffuse>0.26 0.46 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="arena_wall_east">
      <static>true</static>
      <pose>10.1 0 0.425 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20.4 0.85</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 20.4 0.85</size></box></geometry>
          <material><ambient>0.42 0.48 0.20 1</ambient><diffuse>0.58 0.68 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="arena_wall_west">
